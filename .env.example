# ====================================================================
# HSC AI Study Intelligence System - Environment Configuration Template
# ====================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (or '.env.local'):
#    cp .env.example .env
# 2. Add your Google Gemini API key below.
# 3. NEVER commit your actual '.env' or API keys to version control.
# ====================================================================

# Google Gemini API Key (Required for AI Tutoring, Vision OCR, and Grading)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Optional, defaults to 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# CLI Subprocess AI Tutor Engine (Zero Gemini API Key required for AI Tutor)
# Can be: 'python scripts/tutor_cli.py' or 'ollama run llama3.2' or custom CLI
TUTOR_CLI_COMMAND=python scripts/tutor_cli.py
TUTOR_USE_GEMINI=false

